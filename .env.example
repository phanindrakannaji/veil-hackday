# Veil Hack Day — copy to .env for local demo
PORT=8787

# Media Rights Graph (Neo4j). Defaults match Docker: docker run … neo4j:5
# Auth for Browser http://localhost:7474 — user neo4j / password veil-hackday
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=veil-hackday
# Set to 0/false to force in-memory only
# NEO4J_ENABLED=1

# Crusoe Inference — primary Explain / Consent brief / Revoke impact (optional)
# Key may also live in .env.crusoe (gitignored)
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Demo default: fast flash with reliable content. Override to zai-org/GLM-5.3-Flash or openai/gpt-oss-120b.
CRUSOE_MODEL=deepseek-ai/Deepseek-V4-Flash

# OpenRouter — Explain fallback + multi-model Judge panel (optional)
# Key may also live in .env.openrouter (gitignored)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_PANEL_MODELS=openai/gpt-4o-mini,qwen/qwen-2.5-7b-instruct,mistralai/mistral-small-3.1-24b-instruct
